rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Questions collection and its subcollections
    match /questions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true; // Allow counts to be updated by anyone
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || request.auth.token.email.lower() == "haixdao0923@gmail.com");

      // Nested likes on questions
      match /likes/{likeId} {
        allow read, write: if true;
      }

      // Responses subcollection
      match /responses/{responseId} {
        allow read: if true;
        allow create: if true; // Guest responses
        allow update: if true; // Counts and content
        allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || request.auth.token.email.lower() == "haixdao0923@gmail.com");
      }
    }
  }
}
